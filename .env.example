# ============================================================
# College Management System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME="College Management System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/CMS/public
APP_KEY=

# ─── Database ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ────────────────────────────────────────────────
SESSION_NAME=cms_session
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true

# ─── File Upload ────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_PATH=../storage/uploads

# ─── Logging ────────────────────────────────────────────────
LOG_PATH=../storage/logs
LOG_LEVEL=debug

# ─── Email (future) ─────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@college.edu
MAIL_FROM_NAME="College Management System"

# ─── Security ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
