# ============================================================
# College Management System — .gitignore
# ============================================================

# Environment
.env

# Dependencies
/vendor/

# Storage (runtime data — never commit)
/storage/logs/*
/storage/uploads/*
!/storage/logs/.gitkeep
!/storage/uploads/.gitkeep
!/storage/uploads/students/.gitkeep
!/storage/uploads/faculty/.gitkeep
!/storage/uploads/documents/.gitkeep
!/storage/uploads/receipts/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# PHP
*.log
.phpunit.cache/

# Build scripts & scratch
create_structure.ps1
/scratch/
